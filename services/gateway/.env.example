# SkyWatch Gateway Configuration
# Copy this file to .env and edit with your local settings
# NEVER commit the .env file to version control

# Server port
PORT=8080

# Observer location (latitude, longitude in decimal degrees; altitude in km)
OBSERVER_LAT=51.5074
OBSERVER_LON=-0.1278
OBSERVER_ALT_KM=0.03

# Flight detection range (kilometers from observer)
FLIGHT_RANGE_KM=50

# Minimum elevation angle for visibility (degrees above horizon)
MIN_ELEVATION_DEG=10

# Satellite group to track (e.g., 'visual' for naked-eye visible satellites)
SATELLITE_GROUP=visual

# Time window for pass predictions (hours into the future)
PASS_WINDOW_HOURS=6

# OpenSky Network credentials (optional — OpenSky works anonymously with stricter rate limits)
# Do NOT commit real credentials to version control
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# API endpoints
OPENSKY_BASE_URL=https://opensky-network.org/api
CELESTRAK_BASE_URL=https://celestrak.org/NORAD/elements/gp.php
