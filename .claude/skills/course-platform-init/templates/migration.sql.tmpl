-- Migration {{NUMBER}}: seed course "{{COURSE_TITLE}}" ({{COURSE_SLUG}})
-- Generated by course-platform-init (add-course mode).
-- Prefix MUST match existing tables: {{PREFIX}}
-- Apply manually (Supabase SQL editor or `supabase db push`). Idempotent.

-- 1. Path -------------------------------------------------------------------
INSERT INTO {{PREFIX}}learning_paths (id, slug, title, level, description)
VALUES ({{PATH_ID}}, '{{COURSE_SLUG}}', '{{COURSE_TITLE}}', '{{LEVEL}}', '{{DESCRIPTION}}')
ON CONFLICT (slug) DO NOTHING;

-- 2. Modules + Lessons ------------------------------------------------------
-- Repeat per module/lesson parsed from syllabus.md. Keep ordering via sort_order.
{{#each LESSONS}}
INSERT INTO {{../PREFIX}}lessons (id, path_slug, module, title, sort_order, body)
VALUES ('{{id}}', '{{../COURSE_SLUG}}', '{{module}}', '{{title}}', {{sort_order}}, '{{body}}')
ON CONFLICT (id) DO NOTHING;
{{/each}}

-- 3. Exercises (if course-material/exercises/* provided) --------------------
{{#each EXERCISES}}
INSERT INTO {{../PREFIX}}skill_lab_exercises (id, lesson_id, title, prompt, solution, difficulty)
VALUES ('{{id}}', '{{lesson_id}}', '{{title}}', '{{prompt}}', '{{solution}}', '{{difficulty}}')
ON CONFLICT (id) DO NOTHING;
{{/each}}

-- 4. Security: RLS + grants (REQUIRED — see references/best-practices.md §Security)
-- Only needed when this migration CREATES tables. Seeds into existing tables inherit
-- their policies. If you created any new table above, add for EACH:
--
--   ALTER TABLE {{PREFIX}}<table> ENABLE ROW LEVEL SECURITY;
--   CREATE POLICY "<table>_select_auth" ON {{PREFIX}}<table>
--     FOR SELECT TO authenticated USING (true);   -- catalog is readable by signed-in users
--   GRANT SELECT ON {{PREFIX}}<table> TO authenticated;
--   GRANT SELECT, INSERT, UPDATE ON {{PREFIX}}<table> TO service_role;

-- 5. Knowledge graph (if config.knowledge_graph.enabled: true) ---------------
-- The KG is the CONTENT ENGINE, not a decoration: author/extend it FIRST, then
-- generate lessons FROM it (cite-or-refuse). Full schema, embeddings, build
-- pipeline, and the GraphRAG tutor are in references/knowledge-graph.md — read it.
-- Tables ({{PREFIX}}kg_node / kg_edge / lesson_concept) are created once at
-- bootstrap; this seed only INSERTS content rows into them.
{{#if KNOWLEDGE_GRAPH}}
-- Nodes: each carries citations (source_refs) and a kind from the domain taxonomy.
-- embedding is backfilled out-of-band by the build pipeline (MiniLM-L6-v2, 384-dim).
{{#each KG_NODES}}
INSERT INTO {{../PREFIX}}kg_node (node_id, kind, name, aliases, summary, body, source_refs)
VALUES ('{{node_id}}', '{{kind}}', '{{name}}', ARRAY[{{aliases}}]::text[],
        '{{summary}}', '{{body}}', '{{source_refs}}'::jsonb)
ON CONFLICT (kind, name) DO NOTHING;
{{/each}}
-- Edges: typed relations (prerequisite_of|teaches|part_of|depends_on|...).
{{#each KG_EDGES}}
INSERT INTO {{../PREFIX}}kg_edge (edge_id, from_node, to_node, relation, weight)
VALUES ('{{edge_id}}', '{{from_node}}', '{{to_node}}', '{{relation}}', {{weight}})
ON CONFLICT (from_node, to_node, relation) DO NOTHING;
{{/each}}
-- Lesson -> concept links: which verified nodes each lesson teaches.
{{#each LESSON_CONCEPTS}}
INSERT INTO {{../PREFIX}}lesson_concept (lesson_id, node_id)
VALUES ('{{lesson_id}}', '{{node_id}}')
ON CONFLICT (lesson_id, node_id) DO NOTHING;
{{/each}}
{{/if}}
