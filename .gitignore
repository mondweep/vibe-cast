# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Test / coverage
coverage/

# Logs
*.log
npm-debug.log*

# RuFlo / Claude-Flow runtime (keep root config, ignore runtime data anywhere)
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/
**/.claude-flow/data/
**/.claude-flow/logs/
**/.claude-flow/sessions/
# Nested .claude-flow created by running ruflo inside a subproject — pure runtime
services/**/.claude-flow/
.swarm/
memory/

# Firmware build artefacts (PlatformIO)
firmware/.pio/
firmware/.vscode/

# Secrets / local env
.env
.env.local
*.local

# OS
.DS_Store
Thumbs.db
