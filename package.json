{
  "name": "assam-flood-monitoring",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Decision console for ASDMA Assam daily flood bulletins",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "generate:default-bulletin": "vite-node scripts/generate-default-bulletin.ts",
    "generate:assam-districts": "vite-node scripts/generate-assam-districts.ts",
    "verify:lazy-pdfjs": "vite-node scripts/verify-lazy-pdfjs.ts",
    "typecheck": "tsc -b && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^26.1.0",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
