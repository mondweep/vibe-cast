# Cloud Run service environment.
#
# The Firebase values below are the *web client* config. A Firebase web apiKey
# is a public project identifier rather than a credential — security comes
# from Firebase rules and server-side token verification, not from hiding it.
# It is served to the browser by GET /api/v1/config.
#
# Leave them unset and the app runs local-only: capture, detection and
# analysis all still work, and nothing is uploaded.

GOOGLE_CLOUD_PROJECT=vibe-cast-projects
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_AUTH_DOMAIN=
