# Supabase Configuration (Modern Pattern)
# =========================================

# Project URL (found in Settings → Configuration)
SUPABASE_URL=https://your-project-id.supabase.co

# Public API Key (safe for browser/client-side use)
# Use in frontend applications, exposed to users
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Secret API Key (NEVER expose to frontend/client)
# Use ONLY in backend services, edge functions, server components
# Keep this secure and never commit to version control
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Database Configuration (Optional)
# ===================================
# Direct PostgreSQL connection (if needed for server-side operations)
DATABASE_URL=postgresql://postgres:[password]@db.your-project-id.supabase.co:5432/postgres

# Database Schema (for multi-tenant or schema-specific operations)
DATABASE_SCHEMA=ruflo_demo

# Application Configuration
# ==========================
NODE_ENV=development

# Event Bus Configuration
# =======================
# Set to 'rabbitmq' for production, 'memory' for development
EVENT_BUS_TYPE=memory

# Logging
# =======
LOG_LEVEL=info
